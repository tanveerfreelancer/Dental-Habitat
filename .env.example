# The public domain, no trailing slash. Leave empty until the real domain is confirmed:
# canonical, og:url, sitemap.xml and the schema "url" are generated from it, and are
# omitted (with a build warning) rather than guessed.
SITE_URL=

# Where the appointment request form sends its JSON. Leave empty until you have one.
# Any service that accepts a JSON POST works (Formspree, Getform, a Netlify function, your own API).
# While empty, a valid submission shows an honest "not sent, please call" message and sends nothing.
VITE_CONTACT_ENDPOINT=
